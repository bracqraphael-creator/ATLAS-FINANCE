# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.

# Supabase (Paramètres du projet > API)
NEXT_PUBLIC_SUPABASE_URL=
# (ancienne clé anon, remplacée par la clé publiable ci-dessous)
SUPABASE_SERVICE_ROLE_KEY=

# Moteur de calcul
ENGINE_URL=http://localhost:8000

# Fournisseur de cours : yahoo (gratuit, sans clé, usage personnel / prototype),
# eodhd (sous licence, clé requise, avant commercialisation) ou demo (cours fictifs)
MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_API_KEY=

# Plus tard
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=

# Clé publiable Supabase (côté navigateur, protégée par les politiques RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
